{
    "name": "schachbulle/contao-claude-bundle",
    "type": "contao-bundle",
    "description": "Stellt eine Contao-Installation als MCP-Server für Claude bereit: Seiten, Artikel, Nachrichten, Dateien und Datensätze lesen, immer mit den Rechten des eigenen Backend-Zugangs.",
    "keywords": [
        "contao",
        "claude",
        "mcp",
        "model context protocol",
        "ki",
        "redaktion"
    ],
    "homepage": "https://github.com/Samson1964/contao-claude-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Hoppe",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^4.13 || ^5.3",
        "mcp/sdk": "~0.9.0",
        "nyholm/psr7": "^1.8",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-foundation": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0",
        "symfony/security-core": "^5.4 || ^6.4 || ^7.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "contao/news-bundle": "Für die Werkzeuge news_search und news_get"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoClaudeBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoClaudeBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schachbulle\\ContaoClaudeBundle\\Tests\\": "tests/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-claude-bundle/issues",
        "source": "https://github.com/Samson1964/contao-claude-bundle"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false
        }
    }
}
